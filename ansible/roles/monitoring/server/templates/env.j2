# Managed by Ansible (role monitoring/server). Содержит секрет — 0600 root.
TZ={{ monitoring_timezone }}
GF_SECURITY_ADMIN_PASSWORD={{ monitoring_grafana_admin_password }}
# Grafana за Traefik: без root_url/domain ломаются редиректы, OAuth и live-логи.
GF_SERVER_ROOT_URL={{ grafana_root_url }}
GF_SERVER_DOMAIN={{ grafana_domain }}
GF_SERVER_ENFORCE_DOMAIN=false