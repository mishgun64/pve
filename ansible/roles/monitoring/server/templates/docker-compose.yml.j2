# Managed by Ansible (role monitoring/server). Не редактировать вручную:
# изменения затрутся при следующем прогоне роли/пайплайна.
#
# Стек живёт в /opt/monitoring, данные — bind-mount в ./data.
# Наружу опубликованы только 9090 (Prometheus), 9093 (Alertmanager), 3000
# (Grafana); доступ ограничен nftables (п.10.2 MONITORING-PLAN.md).
name: monitoring

services:
  prometheus:
    image: "{{ prometheus_image }}"
    container_name: prometheus
    restart: unless-stopped
    command:
      - "--config.file=/etc/prometheus/prometheus.yml"
      - "--storage.tsdb.path=/prometheus"
      - "--storage.tsdb.retention.time={{ prometheus_retention }}"
      - "--web.enable-lifecycle"
      - "--web.listen-address=:9090"
    ports:
      - "{{ monitoring_bind_address }}:{{ prometheus_port }}:9090"
    volumes:
      - "./prometheus:/etc/prometheus:ro"
      - "./data/prometheus:/prometheus"
    # Self-scrape: Prometheus в контейнере не видит node_exporter/cAdvisor
    # самого control через localhost — только через адрес docker-моста.
    extra_hosts:
      - "host.docker.internal:host-gateway"
    depends_on:
      - alertmanager
      - blackbox
      - pve_exporter
    networks:
      - monitoring

  alertmanager:
    image: "{{ alertmanager_image }}"
    container_name: alertmanager
    restart: unless-stopped
    command:
      - "--config.file=/etc/alertmanager/alertmanager.yml"
      - "--storage.path=/alertmanager"
      - "--web.listen-address=:9093"
      # POST /-/reload: роль перечитывает alertmanager.yml без перезапуска.
      - "--web.enable-lifecycle"
    ports:
      - "{{ monitoring_bind_address }}:{{ alertmanager_port }}:9093"
    volumes:
      - "./alertmanager:/etc/alertmanager:ro"
      - "./data/alertmanager:/alertmanager"
    networks:
      - monitoring

  grafana:
    image: "{{ grafana_image }}"
    container_name: grafana
    restart: unless-stopped
    # GF_SECURITY_ADMIN_PASSWORD / GF_SERVER_ROOT_URL / TZ
    env_file:
      - .env
    environment:
      - "GF_SECURITY_ADMIN_USER={{ grafana_admin_user }}"
      - "GF_USERS_ALLOW_SIGN_UP=false"
      - "GF_USERS_ALLOW_ORG_CREATE=false"
      - "GF_ANALYTICS_REPORTING_ENABLED=false"
      - "GF_ANALYTICS_CHECK_FOR_UPDATES=false"
      - "GF_NEWS_NEWS_FEED_ENABLED=false"
    ports:
      - "{{ monitoring_bind_address }}:{{ grafana_port }}:3000"
    volumes:
      - "./data/grafana:/var/lib/grafana"
      - "./grafana/provisioning:/etc/grafana/provisioning:ro"
      - "./grafana/dashboards:/var/lib/grafana/dashboards:ro"
    networks:
      - monitoring

  blackbox:
    image: "{{ blackbox_image }}"
    container_name: blackbox
    restart: unless-stopped
    command:
      - "--config.file=/etc/blackbox/blackbox.yml"
    # Порт 9115 нужен только Prometheus внутри compose-сети.
    expose:
      - "{{ blackbox_port }}"
    volumes:
      - "./blackbox:/etc/blackbox:ro"
    # ICMP-пробы требуют raw-сокет: root + только NET_RAW, либо unprivileged
    # ping через ping_group_range (ставим оба варианта — работает на любом ядре).
    user: "0:0"
    cap_drop:
      - ALL
    cap_add:
      - NET_RAW
    sysctls:
      net.ipv4.ping_group_range: "0 2147483647"
    networks:
      - monitoring

  pve_exporter:
    image: "{{ pve_exporter_image }}"
    container_name: pve_exporter
    restart: unless-stopped
    command:
      - "--config.file=/etc/prometheus/pve.yml"
    # Порт 9221 нужен только Prometheus внутри compose-сети.
    expose:
      - "{{ pve_exporter_port }}"
    volumes:
      - "./pve:/etc/prometheus:ro"
    networks:
      - monitoring

networks:
  monitoring:
    name: monitoring
    driver: bridge