all:
  vars:
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
    # Пиннинг host-ключей: контейнеры CI эфемерны, ~/.ssh/known_hosts в них пуст,
    # из-за чего при host_key_checking=True падало "Host key verification failed".
    # Файл лежит в репозитории и содержит только публичные host-ключи.
    ansible_ssh_common_args: >-
      -o UserKnownHostsFile={{ inventory_dir | default('ansible') }}/known_hosts

  children:
    # Proxmox-хосты и control node
    pve_hosts:
      hosts:
        pve:
          ansible_host: 192.168.2.2
        control_node:
          ansible_host: 192.168.2.200
        pve_iso_server:
          ansible_host: 192.168.1.72

    # VM/LXC с Docker-сервисами
    docker_hosts:
      hosts:
        media_vm:
          ansible_host: 192.168.2.4
        nextcloud_vm:
          ansible_host: 192.168.2.5
        wg_lxc:
          ansible_host: 192.168.2.6
        traefik_lxc:
          ansible_host: 192.168.2.3
        pvpgn_lxc:
          ansible_host: 192.168.2.8
        valheim_lxc:
          ansible_host: 192.168.2.9
        santa_bot_lxc:
          ansible_host: 192.168.2.11

    # Мониторинг: агенты (node_exporter) на всех хостах, КРОМЕ pve_iso_server
    # (решение п.12 плана: PXE/ISO-сервер в мониторинг не входит).
    monitoring_agents:
      children:
        docker_hosts:
      hosts:
        pve:
        control_node:

    # cAdvisor ставится только там, где есть Docker (docker_hosts + control).
    monitoring_cadvisor:
      children:
        docker_hosts:
      hosts:
        control_node:

    # Сервер мониторинга: Prometheus/Alertmanager/Grafana/blackbox/pve_exporter
    # в Docker на control_node (192.168.2.200).
    monitoring_server:
      hosts:
        control_node:
